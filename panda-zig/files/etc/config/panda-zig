config panda-zig 'config'
	option enabled '0'
	option log_to_file '1'
	option log_file '/var/log/panda-zig.log'
	option check_interval '300'

config provider 'provider0'
	option name 'my_ddns'
	option enabled '0'
	option provider 'cloudflare'
	option domain 'example.com'
	option hostname '@'
	option api_token ''
	option ip_mode 'dual'
	option ttl '120'
	option proxied '0'
