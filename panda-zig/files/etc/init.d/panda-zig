#!/bin/sh /etc/rc.common
# panda-zig — Zig DDNS 守护进程 (panda 的 Zig 重写版本)

USE_PROCD=1
START=91
STOP=11

NAME="panda-zig"
DDNS_BIN="/usr/bin/panda-zig"

start_service() {
    _ensure_logs
    _start_ddns
}

_ensure_logs() {
    mkdir -p /var/log
    [ -f /var/log/panda-zig.log ] || touch /var/log/panda-zig.log
}

_start_ddns() {
    config_load panda-zig
    config_get DDNS_ENABLED global ddns_enabled '1'
    config_get DDNS_INTERVAL global ddns_interval '300'

    [ "$DDNS_ENABLED" = "1" ] || {
        logger -t "$NAME" "DDNS 已禁用 — 跳过启动"
        return 0
    }
    [ -x "$DDNS_BIN" ] || {
        logger -t "$NAME" "错误：二进制文件未找到：$DDNS_BIN"
        return 1
    }

    procd_open_instance "panda-zig-ddns"
    procd_set_param command "$DDNS_BIN" "/etc/config/panda-zig"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 60 5 30
    procd_set_param file /etc/config/panda-zig
    procd_close_instance

    logger -t "$NAME" "DDNS (Zig) 已启动（更新间隔：${DDNS_INTERVAL} 秒）"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "panda-zig"
}

boot() {
    start
}
