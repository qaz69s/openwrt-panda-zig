{
  "luci-app-panda-rust": {
    "description": "Grant LuCI access to Panda Rust DDNS",
    "read": {
      "ubus": {
        "uci":     [ "get", "state" ],
        "file":    [ "read" ],
        "service": [ "list" ],
        "luci.panda-rust": [ "clearLog" ]
      },
      "uci": {
        "panda-rust": [ "*" ]
      },
      "file": {
        "/var/log/panda-rust.log": [ "read" ],
        "/etc/config/panda-rust": [ "read" ],
        "/usr/libexec/rpcd/luci.panda-rust": [ "exec" ]
      }
    },
    "write": {
      "ubus": {
        "uci":     [ "set", "apply", "commit", "revert", "add", "delete",
                     "rename", "order", "changes" ],
        "file":    [ "write" ],
        "luci.panda-rust": [ "clearLog" ]
      },
      "uci": {
        "panda-rust": [ "*" ]
      },
      "file": {
        "/var/log/panda-rust.log": [ "write" ],
        "/usr/libexec/rpcd/luci.panda-rust": [ "exec" ]
      }
    }
  }
}
