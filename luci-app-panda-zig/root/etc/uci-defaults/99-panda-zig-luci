#!/bin/sh
# /etc/uci-defaults/99-panda-zig-luci
# 授予 LuCI 会话访问 panda-zig ACL 组的权限

# 确保 rpcd helper 可执行（部分编译不自动 +x）
chmod +x /usr/libexec/rpcd/luci.panda-zig

uci -q batch <<-EOF
	set rpcd.panda-zig=login
	set rpcd.panda-zig.username=root
	set rpcd.panda-zig.password=\$p\$root
	add_list rpcd.panda-zig.read=luci-app-panda-zig
	add_list rpcd.panda-zig.write=luci-app-panda-zig
EOF
uci commit rpcd

# 重启 rpcd 以加载新的 ACL 和 helper
/etc/init.d/rpcd restart

exit 0
